# librechat-router configuration. All values are optional; the defaults shown
# match a standard LibreChat + JEV-9B deployment. Copy to .env and adjust.

# Port the router listens on (the public chat port points here).
PORT=3081

# The LibreChat API the router proxies to. UPSTREAM_HOST is the container name
# when running inside the same docker network as LibreChat.
UPSTREAM_HOST=librechat-api
UPSTREAM_PORT=3080

# JEV-9B decision endpoint. JEV_BASE is the host:port of the JEV gateway and
# JEV_PATH is the /v1/decide route under it.
JEV_BASE=http://192.168.50.106:8081
JEV_PATH=/upstream/jev-9b/v1/decide

# The two agents the router manages. These are the PUBLIC agent ids (the
# `id` field, not the Mongo `_id`), as seen by the LibreChat UI and /api/agents.
# RECEPTIONIST_ID answers everything non-image on the standard Spark model.
# ROUTER_AGENT_ID is the image-generation agent.
RECEPTIONIST_ID=agent_3fs4vNxAoN9duaGKlwObE
ROUTER_AGENT_ID=agent_hgrCkcWQEk8znW4L5zoMe
ROUTER_AGENT_MODEL=qwen38-27b-nvfp4-single-node

# A message routes to the image agent when JEV-9B returns choice=image OR
# pImage > ROUTER_THRESHOLD. Raise above ~0.65 to stop borderline phrases
# (e.g. "what is the date", pImage ~0.64) from misrouting to the image agent.
ROUTER_THRESHOLD=0.5

# How long to wait for a JEV-9B decision before failing open (forwarding the
# request unchanged so chat never breaks).
JEV_TIMEOUT_MS=10000
